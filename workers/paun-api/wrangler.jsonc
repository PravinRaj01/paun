// Cloudflare Worker config for Paun's backend (health check now; the live-price feed and the scanner later).
// Deployed on its own, separately from the web app (../../wrangler.jsonc):  bun run deploy:api
// Secrets (GOLDAPI_KEY, GEMINI_API_KEY, ...) are never written here: set them with `wrangler secret put`.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "paun-api",
  "main": "src/index.ts",

  // Pinned on purpose, like the web Worker: bump it deliberately after testing.
  "compatibility_date": "2026-10-06",
  // Better Auth (accounts) uses AsyncLocalStorage and Node-style crypto, which this flag provides.
  "compatibility_flags": ["nodejs_compat"],

  // Refresh the shared gold price every 15 minutes, Monday to Friday (UTC). Gold futures trade from Sunday evening to Friday
  // evening, so this covers the market; at weekends the last price simply stays. Triggers run on UTC.
  "triggers": { "crons": ["*/15 * * * 1-5"] },

  // The latest price and the GoldAPI call counters. No id on purpose: Wrangler creates the namespace on the first deploy
  // (and says so), so there is no id to copy around. It holds no secret.
  "kv_namespaces": [{ "binding": "SPOT" }],

  // The owner's GoldAPI plan allows 100 calls a month. These caps are enforced in code (src/budget.ts), never exceeded.
  // The key itself is a secret: `bunx wrangler secret put GOLDAPI_KEY -c workers/paun-api/wrangler.jsonc`.
  "vars": {
    "MONTHLY_BUDGET": "90",
    "DAILY_BUDGET": "3",

    // The receipt scanner (POST /scan). The two secrets it needs are NOT here: GEMINI_API_KEY and TURNSTILE_SECRET are set with
    // `wrangler secret put`; until both exist the endpoint answers 503 scanner_not_configured, so deploying first is safe.
    // The model is checked against Google's current model list; change it here without touching code.
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    // At most this many scans a day for everyone (each costs a fraction of a cent), and this many per visitor per hour.
    "SCAN_DAILY_CAP": "200",
    "SCAN_PER_VISITOR_HOUR": "10",

    // Optional accounts (PLAN.md 4b). The Google client id is public (the page needs it too); the secrets DATABASE_URL,
    // BETTER_AUTH_SECRET and GOOGLE_CLIENT_SECRET are set with `wrangler secret put` and never written here.
    "GOOGLE_CLIENT_ID": "745030658975-4nlu1tjvdqb9ga7u0oralmf2mpqskchc.apps.googleusercontent.com",
    // The public address of this Worker; the library builds its own URLs from it. Local runs override it (see docs/deploy.md).
    "BETTER_AUTH_URL": "https://paun-api.paun-gold.workers.dev",
  },

  // Logs show status codes and timings only; nothing here logs a request body (the scanner's photos must never be logged).
  "observability": {
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": false, "head_sampling_rate": 1, "persist": true },
  },

  // Needed by `wrangler preview`, which Cloudflare runs for builds of branches other than main (same as the web Worker).
  "previews": {},
}
