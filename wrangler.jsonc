// Cloudflare Worker config for the Paun front end (SSR + static assets).
//
// `bun run build` has Nitro merge this file with what only the build knows (the server entry, the static-assets
// directory) and write the result to .output/server/wrangler.json, plus .wrangler/deploy/config.json, which makes
// `wrangler deploy` run from the project root use that generated file. Do not set `main` or `assets` here: Nitro owns them.
//
// The backend is a separate Worker (workers/paun-api, later) with its own config, cron triggers and secrets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paun-web",

  // Pinned on purpose. Left unset, Nitro uses the day you build, so the Worker's runtime behaviour would change silently
  // over time. Bump it deliberately, after testing (https://developers.cloudflare.com/workers/configuration/compatibility-dates/).
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],

  // Workers Logs: server-side render errors and console output appear in the Cloudflare dashboard.
  // Spelled out in full (the shorthand `{ "enabled": true }` means the same) so a deploy never silently changes dashboard
  // settings. head_sampling_rate 1 = log every request; lower it (e.g. 0.1) if traffic grows and log volume matters.
  // Traces stay off: nothing in the front end needs them yet.
  "observability": {
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": false, "head_sampling_rate": 1, "persist": true },
  },

  // Needed by `wrangler preview`, which Cloudflare runs for builds of branches other than main: it publishes a throwaway
  // Preview of the Worker named after the git branch, so a pull request can be tried without touching the live site.
  // The block can stay empty: assets, compatibility settings and observability above apply to previews as well.
  "previews": {},

  // Custom domain, once you have one (the domain must be on this Cloudflare account):
  // "routes": [{ "pattern": "paun.example.com", "custom_domain": true }]
}
